# Publishing through the APIs — copy to .env and fill in. NEVER commit .env.

# Instagram: a BUSINESS account (Creator cannot publish through the API), with
# the instagram_content_publish permission. Both of Meta's flows work — the
# code picks the host from the token prefix:
#   IGAA... -> Instagram login, Business account directly (no Page in between)
#   EAAG... -> Facebook login, account linked to a Page
# Generate it in the app dashboard (Instagram -> API setup). The account has to
# be listed as an Instagram Tester under the app's roles, and accept the invite.
# The token lasts ~60 days: note the expiry, because an expired one breaks
# publish.
IG_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# YouTube (OAuth2): run scripts/youtube_auth.py once to generate the refresh
# token.
YT_CLIENT_SECRET_PATH=
YT_REFRESH_TOKEN=

# Short privacy: public (the default when empty), unlisted or private.
# `unlisted` goes up visible only by link — you can check it on the channel
# before opening it to the public. A value with a typo aborts before the
# upload, instead of publishing openly by accident.
YT_PRIVACY=

# Temporary storage Instagram fetches the media from (prefix tmp-publish/).
#
# The bucket must stay PRIVATE (block public access on). What grants access to
# the media is the signed URL the code generates, valid for 1h and removed
# after publishing. A public bucket would leave the whole of tmp-publish/
# reachable by anyone holding the URL, without the short validity as
# protection.
S3_PUBLISH_BUCKET=

# Storage credentials. On AWS you can leave these blank and use the SDK's
# default path (~/.aws/credentials); on another provider, fill them in here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Storage endpoint. Empty = AWS S3. Cloudflare R2, MinIO and the like speak the
# same API — just point it here, with no code change.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
