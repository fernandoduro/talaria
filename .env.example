# Publicação via API — copie para .env e preencha. NUNCA commitar o .env.

# Instagram: conta BUSINESS (Creator nao publica pela API), com permissao
# instagram_content_publish. Servem os dois fluxos da Meta — o codigo escolhe
# o host pelo prefixo do token:
#   IGAA... -> login do Instagram, conta Business direta (sem Pagina no meio)
#   EAAG... -> login do Facebook, conta vinculada a uma Pagina
# Gere no painel do app (Instagram -> Configuracao da API). A conta precisa
# estar como Testador do Instagram em Funcoes do app, e aceitar o convite.
# O token dura ~60 dias: anote a validade, porque expirado quebra o publish.
IG_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# YouTube (OAuth2): rode scripts/youtube_auth.py uma vez para gerar o refresh token.
YT_CLIENT_SECRET_PATH=
YT_REFRESH_TOKEN=

# Privacidade do Short: public (padrao se vazio), unlisted ou private.
# `unlisted` sobe visivel so por link — da pra conferir no canal antes de
# abrir ao publico. Valor com typo aborta antes do upload, em vez de publicar
# aberto sem querer.
YT_PRIVACY=

# Storage temporario de onde o Instagram busca a midia (prefixo tmp-publish/).
#
# O bucket deve ficar PRIVADO (block public access ligado). Quem da acesso a
# midia e a URL assinada que o codigo gera, valida por 1h e removida depois de
# publicar. Bucket publico deixaria todo o tmp-publish/ acessivel a quem tiver
# a URL, sem a validade curta como protecao.
S3_PUBLISH_BUCKET=

# Credenciais do storage. Na AWS, pode deixar em branco e usar o caminho
# padrao do SDK (~/.aws/credentials); em outro provedor, preencha aqui.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Endpoint do storage. Vazio = AWS S3. Cloudflare R2, MinIO e afins falam a
# mesma API — basta apontar pra ca, sem mudar codigo.
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
